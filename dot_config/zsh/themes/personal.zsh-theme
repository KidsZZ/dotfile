# ==============================================================================
# personal 主题
# ==============================================================================

# 启用 Zsh 提示符颜色，并允许 PROMPT 在每次显示时展开当前目录。
autoload -Uz colors
colors
setopt PROMPT_SUBST

# 第一行显示缩写后的当前路径，第二行显示输入提示符。
# 颜色取自目标样式截图；终端背景色和光标颜色由终端自身配置决定。
PROMPT='%F{#57C7FB}%~%f
%F{#FF6AC1}❯%f '

# personal 不使用右侧提示符，显式清空以避免切换主题时保留旧值。
RPROMPT=''
