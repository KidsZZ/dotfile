# ==============================================================================
# 通用别名
# ==============================================================================

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# 提供不依赖第三方工具的基础目录展示；eza 插件可在加载后覆盖这些别名。
if [[ "$OSTYPE" == darwin* ]]; then
  alias ls='ls -G'
else
  alias ls='ls --color=auto'
fi
alias ll='ls -lh'
alias la='ls -lha'
