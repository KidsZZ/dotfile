_ufw_logging() {
  local params additional second
  second=$words[2]

  if [[ -n "$second" ]]; then
    return
  fi

  params=("on" "off")
  additional=("low" "medium" "high" "full")

  _describe -t params '开关' params
  _describe -t additional '日志级别' additional
}

_ufw_delete() {
  local rules complrules second

  second=$words[2]

  if [[ -n "$second" ]]; then
    return
  fi

  complrules=()
  rules=("${(f)$(ufw status | tr -s ' ' | tail -n +5 | tr -s '\n')}")

  for ((i = 1; i <= ${#rules[@]}; i++)); do
    complrules+=("$i:$rules[i]")
  done

  _describe -t complrules '规则' complrules
}

_ufw_app() {
  local ret=1

  local -a subcmds=(
    "list:列出应用配置"
    "info:显示应用配置详情"
    "update:更新应用配置"
    "default:设置默认应用策略"
  )

  _arguments \
    "1: :{_describe '命令' subcmds}" \
    && ret=0

  return ret
}

_ufw() {
  local curcontext="$curcontext" ret=1
  local -a state line commands

  commands=(
    "enable:启用防火墙"
    "disable:禁用防火墙"
    "default:设置默认策略"
    "logging:设置日志级别"
    "allow:添加允许规则"
    "deny:添加拒绝规则"
    "reject:添加 reject 规则"
    "limit:添加限速规则"
    "delete:删除规则"
    "insert:在指定位置插入规则"
    "route:添加路由规则"
    "reload:重新加载防火墙"
    "reset:重置防火墙"
    "status:显示防火墙状态"
    "show:显示防火墙报告"
    "version:显示版本信息"
    "prepend:在同类规则前添加规则"
    "app:管理应用配置"
  )

  _arguments -C -s -S -n \
    '(- 1 *)'--version'[显示版本信息]: :->full' \
    '(- 1 *)'{-h,--help}'[显示帮助信息]: :->full' \
    '(- 1 *)'--dry-run'[仅显示变更，不实际修改]: :->cmds' \
    '1:命令:->cmds' \
    '*:: :->args' && ret=0

  case "$state" in
    (cmds)
      _describe -t commands '命令' commands
      ;;
    (args)
      local cmd
      cmd=$words[1]
      case "$cmd" in
        (logging)
          _ufw_logging && ret=0
          ;;
        (delete)
          _ufw_delete && ret=0
          ;;
        (app)
          _ufw_app && ret=0
          ;;
        (*)
          _default && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_ufw "$@"

